{
  "name": "forebalance",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ship": "pnpm build && wrangler pages deploy build --project-name=forebalance",
    "hold:pack": "node scripts/publish-hold.mjs",
    "hold:publish": "node scripts/publish-hold.mjs --publish",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "localslip": "^0.2.14",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-string": "^1.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@mlc-ai/web-llm": "^0.2.85",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.13",
    "marked": "^15.0.0",
    "sass": "^1.87.0",
    "svelte-file-dropzone": "^2.0.9",
    "tippy.js": "^6.3.7"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.4",
      "cookie@<0.7.0": "0.7.2",
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.2",
      "immutable": ">=5.1.8",
      "devalue": ">=5.6.4",
      "postcss": ">=8.5.23",
      "nanoid@3": ">=3.3.16",
